# Copy this file to .env and fill in only the platforms you use.
# SRC_ = old (expiring) account     TGT_ = new account
# Never commit .env to Git.

# ---------------- Snowflake ----------------
SRC_SF_ACCOUNT=ORGNAME-ACCOUNTNAME              # Snowsight: SELECT CURRENT_ORGANIZATION_NAME()||'-'||CURRENT_ACCOUNT_NAME();
SRC_SF_USER=YOUR_USERNAME
SRC_SF_PASSWORD=
SRC_SF_ROLE=ACCOUNTADMIN
SRC_SF_WAREHOUSE=COMPUTE_WH
# SRC_SF_AUTHENTICATOR=username_password_mfa    # if your login asks for a Duo MFA approval (keep PASSWORD too)
# SRC_SF_AUTHENTICATOR=externalbrowser          # if you log in with Google/Microsoft SSO
# SRC_SF_DATABASES=MY_DB,OTHER_DB              # optional: only these databases (comma separated)
# SRC_SF_SKIP_DATA=true                         # optional: structure only, no table data

TGT_SF_ACCOUNT=
TGT_SF_USER=
TGT_SF_PASSWORD=
TGT_SF_ROLE=ACCOUNTADMIN
TGT_SF_WAREHOUSE=COMPUTE_WH
# New Azure tenant id for storage integrations (Azure Portal > Microsoft Entra ID > Tenant ID)
# TGT_SF_AZURE_TENANT_ID=
# Point stages at your NEW storage account:
# TGT_SF_URL_REWRITE=oldstorage.blob.core.windows.net=>newstorage.blob.core.windows.net

# ---------------- Azure ----------------
# Storage: Portal > Storage account > Security + networking > Access keys > Connection string
SRC_AZ_STORAGE_CONNECTION_STRING=
# SRC_AZ_CONTAINERS=raw,bronze                  # optional filter
# Data Factory (leave SUBSCRIPTION_ID empty to skip ADF). Uses `az login` unless CLIENT_ID is set.
SRC_AZ_SUBSCRIPTION_ID=
SRC_AZ_TENANT_ID=
SRC_AZ_RESOURCE_GROUP=
SRC_AZ_DATA_FACTORY=
# SRC_AZ_CLIENT_ID=
# SRC_AZ_CLIENT_SECRET=

TGT_AZ_STORAGE_CONNECTION_STRING=
TGT_AZ_SUBSCRIPTION_ID=
TGT_AZ_TENANT_ID=
TGT_AZ_RESOURCE_GROUP=
TGT_AZ_DATA_FACTORY=
TGT_AZ_LOCATION=                                # empty = same region as the old factory
# TGT_AZ_URL_REWRITE=oldstorage=>newstorage

# ---------------- Databricks ----------------
# Token: workspace > Settings > Developer > Access tokens
SRC_DBX_HOST=https://adb-XXXXXXXX.XX.azuredatabricks.net
SRC_DBX_TOKEN=
# SRC_DBX_ROOT=/Users/old@mail.com              # default: your home folder

TGT_DBX_HOST=
TGT_DBX_TOKEN=
# TGT_DBX_EXISTING_CLUSTER_ID=                  # jobs pointing at an old cluster will use this one
